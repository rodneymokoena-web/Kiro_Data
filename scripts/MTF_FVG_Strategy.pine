//@version=6
strategy("4H/1H POI > 15m BOS > 5m FVG/iFVG Strategy", shorttitle="MTF-FVG-STR", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02,
     calc_on_order_fills=false, process_orders_on_close=true)

// ============================================================================
// STRATEGY — same model as the indicator, but places real orders so you can
// backtest it. Run on the 5m chart.
//   Bias (4H sweep / FVG) -> 15m BOS -> capture first overlapping 5m FVG/iFVG
//   -> enter on the tap. SL sits beyond the zone's far edge (+ buffer); exit
//   at a fixed RR multiple or at the broken 15m structure level.
// ============================================================================

// ---------------------------------- Inputs ----------------------------------
gTf   = "Timeframes"
tf4h  = input.timeframe("240", "Bias timeframe (4H)", group=gTf)
tf1h  = input.timeframe("60",  "Second bias timeframe (1H)", group=gTf)
tf15  = input.timeframe("15",  "Structure timeframe (15m)", group=gTf)
useChartForEntry = input.bool(true, "Use chart TF for entry (recommended: run on 5m)", group=gTf)
tf5   = input.timeframe("5",   "Entry timeframe (5m) when above is off", group=gTf)

gBias = "Bias (4H / 1H)"
useH1    = input.bool(true, "Also apply the same bias rules on 1H", group=gBias)
useSweep = input.bool(true, "Bias: swing sweep (4H / 1H)", group=gBias)
useFvg4  = input.bool(true, "Bias: price inside FVG (4H / 1H)", group=gBias)
swLen4   = input.int(5, "Swing length (4H and 1H)", minval=1, group=gBias)
sweepConfirm = input.string("Both", "Sweep type", options=["Wick","Close","Both"], group=gBias)
biasBars = input.int(500, "Bias stays valid for (bars)", minval=20, group=gBias)

gStruct = "15m structure"
swLen15 = input.int(3, "15m swing length", minval=1, group=gStruct)

gEntry = "5m entry zone"
useIFVG = input.bool(true, "Allow inverse-FVG zones", group=gEntry)

gTrade = "Trade management"
slBufPct  = input.float(5.0, "SL buffer beyond zone (%)", minval=0.0, step=0.5, group=gTrade, tooltip="Percent of the zone height added beyond its far edge.")
exitMode  = input.string("RR multiple", "Take-profit mode", options=["RR multiple","Structure level"], group=gTrade)
rrChoice  = input.string("2R", "RR target (2R or 3R)", options=["2R", "3R"], group=gTrade)
rrMult    = rrChoice == "3R" ? 3.0 : 2.0
riskChoice = input.string("1%", "Risk per trade (1% or 0.5% of equity)", options=["1%", "0.5%"], group=gTrade)
riskPct   = riskChoice == "0.5%" ? 0.5 : 1.0

gRisk = "Position sizing / filters"
allowLong   = input.bool(true, "Allow long trades",  group=gRisk)
allowShort  = input.bool(true, "Allow short trades", group=gRisk)
oneAtATime  = input.bool(true, "Only one open position at a time", group=gRisk)
useDates    = input.bool(false, "Limit backtest to a date range", group=gRisk)
startDate   = input.time(timestamp("2023-01-01 00:00"), "Start", group=gRisk)
endDate     = input.time(timestamp("2026-12-31 00:00"), "End",   group=gRisk)

gShow = "Display"
showSell = input.bool(true, "Trade short setups", group=gShow)
showBuy  = input.bool(true, "Trade long setups",  group=gShow)
drawZones = input.bool(true, "Draw zones & POIs", group=gShow)
cPoi  = input.color(color.yellow, "4H POI color", group=gShow)
cZS   = input.color(color.new(color.red, 65),   "Sell zone color", group=gShow)
cZB   = input.color(color.new(color.green, 65), "Buy zone color",  group=gShow)

inWindow = not useDates or (time >= startDate and time <= endDate)

// =============================== 4H DATA =====================================
h4() =>
    ph = ta.pivothigh(high, swLen4, swLen4)[1]
    pl = ta.pivotlow(low,  swLen4, swLen4)[1]
    bFt = high[1] < low[3]  ? low[3]  : na
    bFb = high[1] < low[3]  ? high[1] : na
    uFt = low[1]  > high[3] ? low[1]  : na
    uFb = low[1]  > high[3] ? high[3] : na
    [ph, pl, bFt, bFb, uFt, uFb]

[h4PH, h4PL, h4bFt, h4bFb, h4uFt, h4uFb] = request.security(syminfo.tickerid, tf4h, h4(), lookahead=barmerge.lookahead_off)

var float swHigh4 = na
var float swLow4  = na
if not na(h4PH) and h4PH != nz(h4PH[1])
    swHigh4 := h4PH
if not na(h4PL) and h4PL != nz(h4PL[1])
    swLow4 := h4PL

var box poiSupBox = na
var box poiDemBox = na
var float f4bT = na, var float f4bB = na
var float f4uT = na, var float f4uB = na
if not na(h4bFt) and (h4bFt != nz(h4bFt[1]) or h4bFb != nz(h4bFb[1]))
    f4bT := h4bFt
    f4bB := h4bFb
    if drawZones
        if not na(poiSupBox)
            box.delete(poiSupBox)
        poiSupBox := box.new(bar_index, f4bT, bar_index, f4bB, xloc=xloc.bar_index, border_color=cPoi, bgcolor=color.new(cPoi, 88), extend=extend.right, text="4H FVG", text_color=cPoi, text_size=size.small)
if not na(h4uFt) and (h4uFt != nz(h4uFt[1]) or h4uFb != nz(h4uFb[1]))
    f4uT := h4uFt
    f4uB := h4uFb
    if drawZones
        if not na(poiDemBox)
            box.delete(poiDemBox)
        poiDemBox := box.new(bar_index, f4uT, bar_index, f4uB, xloc=xloc.bar_index, border_color=cPoi, bgcolor=color.new(cPoi, 88), extend=extend.right, text="4H FVG", text_color=cPoi, text_size=size.small)

// ----------------------------- 4H bias flags --------------------------------
wickSweepHi  = not na(swHigh4) and high > swHigh4 and close < swHigh4
closeSweepHi = not na(swHigh4) and high[1] > swHigh4 and close < swHigh4
sweepHi = sweepConfirm == "Wick" ? wickSweepHi : sweepConfirm == "Close" ? closeSweepHi : (wickSweepHi or closeSweepHi)

wickSweepLo  = not na(swLow4) and low < swLow4 and close > swLow4
closeSweepLo = not na(swLow4) and low[1] < swLow4 and close > swLow4
sweepLo = sweepConfirm == "Wick" ? wickSweepLo : sweepConfirm == "Close" ? closeSweepLo : (wickSweepLo or closeSweepLo)

inFvg4Bear = not na(f4bT) and close <= f4bT and close >= f4bB
inFvg4Bull = not na(f4uT) and close <= f4uT and close >= f4uB

// ------------------------- 1H bias (same rules as 4H) ------------------------
[h1PH, h1PL, h1bFt, h1bFb, h1uFt, h1uFb] = request.security(syminfo.tickerid, tf1h, h4(), lookahead=barmerge.lookahead_off)

var float swHigh1 = na
var float swLow1  = na
if not na(h1PH) and h1PH != nz(h1PH[1])
    swHigh1 := h1PH
if not na(h1PL) and h1PL != nz(h1PL[1])
    swLow1 := h1PL

var float f1bT = na, var float f1bB = na   // active 1H bearish FVG
var float f1uT = na, var float f1uB = na   // active 1H bullish FVG
if not na(h1bFt) and (h1bFt != nz(h1bFt[1]) or h1bFb != nz(h1bFb[1]))
    f1bT := h1bFt
    f1bB := h1bFb
if not na(h1uFt) and (h1uFt != nz(h1uFt[1]) or h1uFb != nz(h1uFb[1]))
    f1uT := h1uFt
    f1uB := h1uFb

wickSweepHi1  = not na(swHigh1) and high > swHigh1 and close < swHigh1
closeSweepHi1 = not na(swHigh1) and high[1] > swHigh1 and close < swHigh1
sweepHi1 = sweepConfirm == "Wick" ? wickSweepHi1 : sweepConfirm == "Close" ? closeSweepHi1 : (wickSweepHi1 or closeSweepHi1)
wickSweepLo1  = not na(swLow1) and low < swLow1 and close > swLow1
closeSweepLo1 = not na(swLow1) and low[1] < swLow1 and close > swLow1
sweepLo1 = sweepConfirm == "Wick" ? wickSweepLo1 : sweepConfirm == "Close" ? closeSweepLo1 : (wickSweepLo1 or closeSweepLo1)
inFvg1Bear = not na(f1bT) and close <= f1bT and close >= f1bB
inFvg1Bull = not na(f1uT) and close <= f1uT and close >= f1uB

h1Short = useH1 and ((useSweep and sweepHi1) or (useFvg4 and inFvg1Bear))
h1Long  = useH1 and ((useSweep and sweepLo1) or (useFvg4 and inFvg1Bull))

var int shortBiasBar = na
var int longBiasBar  = na
if h1Short or (useSweep and sweepHi) or (useFvg4 and inFvg4Bear)
    shortBiasBar := bar_index
if h1Long or (useSweep and sweepLo) or (useFvg4 and inFvg4Bull)
    longBiasBar := bar_index
shortBias = not na(shortBiasBar) and bar_index - shortBiasBar <= biasBars
longBias  = not na(longBiasBar)  and bar_index - longBiasBar  <= biasBars

// =============================== 15m DATA ====================================
f15() =>
    pl = ta.pivotlow(low,  swLen15, swLen15)[1]
    ph = ta.pivothigh(high, swLen15, swLen15)[1]
    [pl, ph, close]

[pl15, ph15, close15] = request.security(syminfo.tickerid, tf15, f15(), lookahead=barmerge.lookahead_off)

var float lastPL15 = na
var float lastPH15 = na
if not na(pl15) and pl15 != nz(pl15[1])
    lastPL15 := pl15
if not na(ph15) and ph15 != nz(ph15[1])
    lastPH15 := ph15

prevClose15 = nz(close15[1], close15)
bosDown = shortBias and not na(lastPL15) and close15 < lastPL15 and prevClose15 >= lastPL15
bosUp   = longBias  and not na(lastPH15) and close15 > lastPH15 and prevClose15 <= lastPH15

var float brokenLow15  = na
var bool  armShort     = false
var float brokenHigh15 = na
var bool  armLong      = false
if bosDown
    brokenLow15 := lastPL15
    armShort := true
if bosUp
    brokenHigh15 := lastPH15
    armLong := true

// ========================== 5m ENTRY ZONE LOGIC ==============================
f5() =>
    [high, low, high[2], low[2], high[1], low[1], close, open, time[2]]
[r_h, r_l, r_h2, r_l2, r_h1, r_l1, r_c, r_o, r_t2] = request.security(syminfo.tickerid, tf5, f5(), lookahead=barmerge.lookahead_off)
e_h  = useChartForEntry ? high    : r_h
e_l  = useChartForEntry ? low     : r_l
e_h2 = useChartForEntry ? high[2] : r_h2
e_l2 = useChartForEntry ? low[2]  : r_l2
e_h1 = useChartForEntry ? high[1] : r_h1
e_l1 = useChartForEntry ? low[1]  : r_l1
e_c  = useChartForEntry ? close   : r_c
e_t2 = useChartForEntry ? time[2] : r_t2

var array<float> zTops  = array.new<float>()
var array<float> zBots  = array.new<float>()
var array<int>   zDir   = array.new<int>()
var array<box>   zBox   = array.new<box>()
var array<bool>  zArmed = array.new<bool>()
var array<float> zTgt   = array.new<float>()

overlap(float aT, float aB, float bT, float bB) => aB <= bT and aT >= bB

addEntryZone(float t, float b, int dir, int t0, float tgt) =>
    if drawZones
        col = dir < 0 ? cZS : cZB
        bx = box.new(t0, t, time, b, xloc=xloc.bar_time, border_color=color.new(dir < 0 ? color.red : color.green, 20), bgcolor=col, extend=extend.right, text="5m FVG", text_color=color.gray, text_size=size.small)
        zBox.push(bx)
    else
        zBox.push(na)
    zTops.push(t)
    zBots.push(b)
    zDir.push(dir)
    zArmed.push(true)
    zTgt.push(tgt)

// --- Zone capture (bar close) ---
if showSell and armShort and not na(brokenLow15)
    bearFvg = e_h < e_l2
    bT = e_l2
    bB = e_h
    ifvgBear = useIFVG and (e_l1 > e_h2) and e_c < e_h2
    iT = e_l1
    iB = e_h2
    if bearFvg and overlap(bT, bB, brokenLow15, brokenLow15)
        addEntryZone(bT, bB, -1, e_t2, brokenLow15)
        armShort := false
    else if ifvgBear and overlap(iT, iB, brokenLow15, brokenLow15)
        addEntryZone(iT, iB, -1, e_t2, brokenLow15)
        armShort := false

if showBuy and armLong and not na(brokenHigh15)
    bullFvg = e_l > e_h2
    uT = e_l
    uB = e_h2
    ifvgBull = useIFVG and (e_h1 < e_l2) and e_c > e_l2
    juT = e_l2
    juB = e_h1
    if bullFvg and overlap(uT, uB, brokenHigh15, brokenHigh15)
        addEntryZone(uT, uB, 1, e_t2, brokenHigh15)
        armLong := false
    else if ifvgBull and overlap(juT, juB, brokenHigh15, brokenHigh15)
        addEntryZone(juT, juB, 1, e_t2, brokenHigh15)
        armLong := false

// --- Tap detection, mitigation, and order placement ---
bool goShort = false
bool goLong  = false
float sEntry = na, float sSL = na, float sTP = na
float lEntry = na, float lSL = na, float lTP = na

canTrade = inWindow and (not oneAtATime or strategy.position_size == 0)

if zTops.size() > 0
    for i = zTops.size() - 1 to 0
        t = zTops.get(i)
        b = zBots.get(i)
        d = zDir.get(i)
        armed = zArmed.get(i)
        tgt = zTgt.get(i)
        bx = zBox.get(i)
        if d < 0
            if close > t
                if drawZones and not na(bx)
                    box.delete(bx)
                zTops.remove(i), zBots.remove(i), zDir.remove(i), zBox.remove(i), zArmed.remove(i), zTgt.remove(i)
            else if armed and high >= b
                zArmed.set(i, false)
                if drawZones and not na(bx)
                    box.set_right(bx, time)
                    box.set_extend(bx, extend.none)
                zh  = t - b
                buf = zh * slBufPct / 100.0
                entryP = b
                slP = t + buf
                risk = math.abs(entryP - slP)
                tpP = exitMode == "Structure level" and not na(tgt) and tgt < entryP ? tgt : entryP - risk * rrMult
                if canTrade
                    goShort := true
                    sEntry := entryP, sSL := slP, sTP := tpP
        else
            if close < b
                if drawZones and not na(bx)
                    box.delete(bx)
                zTops.remove(i), zBots.remove(i), zDir.remove(i), zBox.remove(i), zArmed.remove(i), zTgt.remove(i)
            else if armed and low <= t
                zArmed.set(i, false)
                if drawZones and not na(bx)
                    box.set_right(bx, time)
                    box.set_extend(bx, extend.none)
                zh  = t - b
                buf = zh * slBufPct / 100.0
                entryP = t
                slP = b - buf
                risk = math.abs(entryP - slP)
                tpP = exitMode == "Structure level" and not na(tgt) and tgt > entryP ? tgt : entryP + risk * rrMult
                if canTrade
                    goLong := true
                    lEntry := entryP, lSL := slP, lTP := tpP

// --- Orders ---
// Risk-based sizing: qty = (equity * risk%) / (stop distance * point value)
riskQty(float entryP, float slP) =>
    dist = math.abs(entryP - slP)
    q = dist > 0 ? strategy.equity * riskPct / 100.0 / (dist * syminfo.pointvalue) : 0.0
    math.max(q, 0.0)

if goShort
    qS = riskQty(sEntry, sSL)
    if qS > 0
        strategy.entry("Short", strategy.short, qty=qS)
        strategy.exit("Short X", from_entry="Short", stop=sSL, limit=sTP)
if goLong
    qL = riskQty(lEntry, lSL)
    if qL > 0
        strategy.entry("Long", strategy.long, qty=qL)
        strategy.exit("Long X", from_entry="Long", stop=lSL, limit=lTP)

// --------------------------------- Plots -------------------------------------
plotshape(goShort, "Short entry", shape.triangledown, location.abovebar, color.red,   size=size.small)
plotshape(goLong,  "Long entry",  shape.triangleup,   location.belowbar, color.green, size=size.small)
