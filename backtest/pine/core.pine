// ───────────────────────────────────────────────────────────────────────────── types
type Bars
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    array<int>   t
    array<int>   tc
    int          base = 0

type Fvg
    int   dir          // 1 = bullish, -1 = bearish
    float top
    float bot
    int   i3           // absolute index of candle 3
    int   inv = -1     // absolute index of the first opposite close through it

type Sweep
    int    dir         // 1 = swing high taken (short idea), -1 = swing low taken (long idea)
    int    s           // 4H index of the sweep candle
    int    origin      // 4H index where the leg into the sweep started
    float  price
    string tf
    bool   done = false

type Sweep1                 // swing model: a D/W/M level swept on 1H
    int    dir         // 1 = swing high taken (short idea), -1 = swing low taken (long idea)
    int    s1          // 1H index of the sweep candle
    int    s4          // 4H index of the candle containing it (may still be forming)
    float  price
    string tf
    bool   done = false

type Setup
    bool       sh
    float      top
    float      bot
    int        sigT        // close time of the 4H inversion candle
    float      ext         // sweep extreme (located on 1H)
    int        anchor      // 1H index of the extreme
    string     info
    int        state = 0   // 0 active, 1 produced a 1H signal, 2 dead
    array<int> rtI
    array<int> rtO
    int        lastTouch = -10
    float      ob = na     // 4H order block stop level (swing)

type Rt
    int r                  // chart index of the retest
    int origin
    int rh                 // running extreme since the retest
    int tEnd               // trigger window end (time)
    int q0 = -1            // 1H index of the hour containing the touch (CISD)
    int e = -1             // running 1H extreme for CISD

type Sig
    bool      sh
    float     top          // 1H IFVG
    float     bot
    int       sigT         // close time of the 1H inversion candle
    float     ext
    string    info
    string    id
    int       state = 0    // 0 retest/trigger, 1 order, 2 trade open, 3 done
    int       s0 = -1
    int       sPre = -1
    int       lastTouch = -10
    array<Rt> rts
    int       trig = -1
    int       trigT = 0
    string    trigBy = ""
    float     trigLv = na
    int       hi = -1
    float     hiPx = na
    int       fI3 = -1
    float     fTop = na
    float     fBot = na
    float     lvl = na
    float     sl = na
    float     tp = na
    int       liveFrom = -1
    bool      blocked = false
    bool      cancelled = false
    float     entry = na
    int       fillIdx = -1
    float     risk = na
    bool      beDone = false
    string    result = ""
    line      lnE = na
    line      lnS = na
    line      lnT = na
    label     lbE = na
    label     lbS = na
    label     lbT = na
    float     ob = na      // swing stop level (1H OB 50%)
    int       anc = -1     // swing: 1H index of the sweep extreme
    float     tpFix = na   // swing: target = 1H swing low

// ───────────────────────────────────────────────────────────────────────────── Bars helpers
method size(Bars b) => b.base + b.o.size()
method O(Bars b, int i) => b.o.get(i - b.base)
method H(Bars b, int i) => b.h.get(i - b.base)
method L(Bars b, int i) => b.l.get(i - b.base)
method C(Bars b, int i) => b.c.get(i - b.base)
method T(Bars b, int i) => b.t.get(i - b.base)
method TC(Bars b, int i) => b.tc.get(i - b.base)

method add(Bars b, float o, float h, float l, float c, int t, int tc, int maxn) =>
    b.o.push(o)
    b.h.push(h)
    b.l.push(l)
    b.c.push(c)
    b.t.push(t)
    b.tc.push(tc)
    if b.o.size() > maxn
        b.o.shift()
        b.h.shift()
        b.l.shift()
        b.c.shift()
        b.t.shift()
        b.tc.shift()
        b.base += 1

newBars() => Bars.new(array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_int(), array.new_int(), 0)

method tr(Bars b, int i) =>
    float hl = b.H(i) - b.L(i)
    float res = hl
    if i - 1 >= b.base
        float pc = b.C(i - 1)
        res := math.max(hl, math.abs(b.H(i) - pc), math.abs(b.L(i) - pc))
    res

method atr(Bars b, int j) =>
    int k0 = math.max(j - 13, b.base)
    float s = 0.0
    for k = k0 to j
        s += b.tr(k)
    s / (j - k0 + 1)

// displacement: run of consecutive candles closing in the trade direction that ends at candle j
method disp(Bars b, int j, bool sh, int minN = 0) =>
    int sgn = sh ? -1 : 1
    int k = j
    while k >= b.base
        float body = b.C(k) - b.O(k)
        if math.sign(body) == sgn and math.abs(body) >= i_dBody * (b.H(k) - b.L(k))
            k -= 1
        else
            break
    int runStart = k + 1
    int runLen = j - k
    float move = runLen > 0 ? math.abs(b.C(j) - b.O(runStart)) : 0.0
    float a = b.atr(j)
    [runLen >= (minN > 0 ? minN : i_dMin) and move >= i_dAtr * a, runLen, a > 0 ? move / a : 0.0]

method pivHiAt(Bars b, int i, int n, bool strictLeft) =>
    bool ok = i - n >= b.base and i + n < b.size()
    if ok
        float p = b.H(i)
        for k = 1 to n
            float lft = b.H(i - k)
            float rgt = b.H(i + k)
            if (strictLeft ? lft >= p : lft > p) or rgt > p
                ok := false
    ok

method pivLoAt(Bars b, int i, int n, bool strictLeft) =>
    bool ok = i - n >= b.base and i + n < b.size()
    if ok
        float p = b.L(i)
        for k = 1 to n
            float lft = b.L(i - k)
            float rgt = b.L(i + k)
            if (strictLeft ? lft <= p : lft < p) or rgt < p
                ok := false
    ok

// MSS: close through the last confirmed swing (opposite side, i_mssPiv each side) before the extreme, by candle j
method mssHit(Bars b, int ext, int j, bool sh) =>
    bool mss = false
    int pv = -1
    int top = math.min(ext - 1, j - i_mssPiv)
    if top >= b.base + i_mssPiv
        for k = top to b.base + i_mssPiv
            if sh ? b.pivLoAt(k, i_mssPiv, true) : b.pivHiAt(k, i_mssPiv, true)
                pv := k
                break
    if pv >= 0
        float lv = sh ? b.L(pv) : b.H(pv)
        int st = math.max(ext, pv + i_mssPiv + 1)
        if j >= st
            for k = st to j
                if sh ? b.C(k) < lv : b.C(k) > lv
                    mss := true
                    break
    mss

// MSS "most recent swing": from candle s to j, the first close through the most recent swing low (short) / high (long)
// already confirmed at that candle (pivot + i_mssPiv < t), formed before or after the sweep
method mssAny(Bars b, int s, int j, bool sh) =>
    bool mss = false
    if j >= s
        for t = s to j
            int pv = -1
            int top = t - i_mssPiv - 1
            if top >= b.base + i_mssPiv
                for k = top to b.base + i_mssPiv
                    if sh ? b.pivLoAt(k, i_mssPiv, true) : b.pivHiAt(k, i_mssPiv, true)
                        pv := k
                        break
            if pv >= 0
                float lv = sh ? b.L(pv) : b.H(pv)
                if sh ? b.C(t) < lv : b.C(t) > lv
                    mss := true
                    break
    mss

method firstAtOrAfter(Bars b, int t) =>
    int k = b.size() - 1
    while k > b.base
        if b.T(k - 1) >= t
            k -= 1
        else
            break
    k

// FVG bookkeeping on a new candle j: mark first opposite close-throughs, add the new FVG
updFvgs(array<Fvg> F, Bars b, int j, int maxn) =>
    if F.size() > 0
        for k = 0 to F.size() - 1
            Fvg f = F.get(k)
            if f.inv < 0 and f.i3 < j
                if (f.dir == 1 and b.C(j) < f.bot) or (f.dir == -1 and b.C(j) > f.top)
                    f.inv := j
    if j - 2 >= b.base
        if b.L(j) > b.H(j - 2)
            F.push(Fvg.new(1, b.L(j), b.H(j - 2), j))
        if b.H(j) < b.L(j - 2)
            F.push(Fvg.new(-1, b.L(j - 2), b.H(j), j))
    while F.size() > maxn
        F.shift()

// ───────────────────────────────────────────────────────────────────────────── HTF feeds (completed candles only)
f_pivHi(float src, int n) =>
    float p = src[n]
    bool ok = not na(p) and not na(src[2 * n])
    if ok
        for i = 1 to n
            if src[n + i] >= p or src[n - i] > p
                ok := false
    ok ? p : na

f_pivLo(float src, int n) =>
    float p = src[n]
    bool ok = not na(p) and not na(src[2 * n])
    if ok
        for i = 1 to n
            if src[n + i] <= p or src[n - i] < p
                ok := false
    ok ? p : na

// unbroken swing levels of the requested timeframe, as known at the open of its current candle
f_levels(int n) =>
    var array<float> hp = array.new_float()
    var array<int>   ht = array.new_int()
    var array<float> lp = array.new_float()
    var array<int>   lt = array.new_int()
    float h1 = high[1]
    float l1 = low[1]
    int   tc1 = time_close[1]
    float ph = f_pivHi(high[1], n)
    float pl = f_pivLo(low[1], n)
    if not na(h1)
        if hp.size() > 0
            for k = hp.size() - 1 to 0
                if h1 > hp.get(k)
                    hp.remove(k)
                    ht.remove(k)
        if lp.size() > 0
            for k = lp.size() - 1 to 0
                if l1 < lp.get(k)
                    lp.remove(k)
                    lt.remove(k)
        if not na(ph)
            hp.push(ph)
            ht.push(tc1)
        if not na(pl)
            lp.push(pl)
            lt.push(tc1)
        while hp.size() > 60
            hp.shift()
            ht.shift()
        while lp.size() > 60
            lp.shift()
            lt.shift()
    [hp, ht, lp, lt]

f_prev() => [open[1], high[1], low[1], close[1], time[1], time_close[1]]

[dHp, dHt, dLp, dLt] = request.security(syminfo.tickerid, "D", f_levels(i_piv), lookahead=barmerge.lookahead_on)
[wHp, wHt, wLp, wLt] = request.security(syminfo.tickerid, "W", f_levels(i_piv), lookahead=barmerge.lookahead_on)
[mHp, mHt, mLp, mLt] = request.security(syminfo.tickerid, "M", f_levels(i_piv), lookahead=barmerge.lookahead_on)
[o4, h4, l4, c4, t4, tc4] = request.security(syminfo.tickerid, "240", f_prev(), lookahead=barmerge.lookahead_on)
[o1, h1, l1, c1, t1, tc1] = request.security(syminfo.tickerid, "60", f_prev(), lookahead=barmerge.lookahead_on)
new4 = not na(t4) and t4 != nz(t4[1])
new1 = not na(t1) and t1 != nz(t1[1])

// 5m closes for the close-back-through rule (chart closes on a 5m chart, lower-TF data on a 15m chart)
ltfStr = timeframe.in_seconds() >= 300 ? "5" : timeframe.period
a5c = request.security_lower_tf(syminfo.tickerid, ltfStr, close)
a5t = request.security_lower_tf(syminfo.tickerid, ltfStr, time)

// ───────────────────────────────────────────────────────────────────────────── state
var Bars BC = newBars()      // chart timeframe (index == bar_index)
var Bars B1 = newBars()      // 1H
var Bars B4 = newBars()      // 4H
var array<Fvg>   FC = array.new<Fvg>()
var array<Fvg>   F1 = array.new<Fvg>()
var array<Fvg>   F4 = array.new<Fvg>()
var array<int>   PLc = array.new_int()     // chart-TF swing lows (index)
var array<int>   PHc = array.new_int()     // chart-TF swing highs (index)
var array<float> ctC = array.new_float()   // 5m closes
var array<int>   ctT = array.new_int()     // 5m candle open times
var array<float> sweptP = array.new_float()
var array<int>   sweptT = array.new_int()
var array<Sweep> SW = array.new<Sweep>()
var array<Setup> ST = array.new<Setup>()
var array<Sig>   SG = array.new<Sig>()
var array<Sweep1> SW1 = array.new<Sweep1>()   // swing model sweeps
var array<float> l4HP = array.new_float()     // intraday: unbroken 4H swing highs (price / confirmation time)
var array<int>   l4HT = array.new_int()
var array<float> l4LP = array.new_float()     // intraday: unbroken 4H swing lows
var array<int>   l4LT = array.new_int()
var array<float> lSHP = array.new_float()     // intraday: unbroken session highs (1H+ swing filtered)
var array<int>   lSHT = array.new_int()
var array<float> lSLP = array.new_float()     // intraday: unbroken session lows
var array<int>   lSLT = array.new_int()
var float sesHi = na                          // running high/low of the session currently open
var float sesLo = na
var int   sesId = -1                          // which session is open (0 Asia, 1 London, 2 NY); -1 = none
var array<float> haP = array.new_float()      // unbroken D/W/M levels tracked on 1H (swing)
var array<int>   haT = array.new_int()
var array<bool>  haHi = array.new_bool()
var array<string> haTf = array.new_string()
var array<int>   haLast = array.new_int(8, 0)  // newest confirmation time merged per list (D/W/M H/L + 4H H/L)
var array<int>   haKeys = array.new_int()      // 4H FVGs that already produced a swing setup
var int   nTrades = 0
var int   nBE = 0
var float grossW = 0.0
var float grossL = 0.0
var float holdH = 0.0
var int   nWins = 0
var int   nLoss = 0
var float sumR = 0.0
var int   n4 = 0
var int   n1 = 0

// ───────────────────────────────────────────────────────────────────────────── helpers using state
// rule 2: sweep detection for one level list on 4H candle j
f_sweeps(array<float> lvP, array<int> lvT, bool isHigh, string tf, int j) =>
    if not na(lvP)
        if lvP.size() > 0
            for k = 0 to lvP.size() - 1
                float p = lvP.get(k)
                int   ct = lvT.get(k)
                bool hit = isHigh ? B4.H(j) > p : B4.L(j) < p
                if ct <= B4.T(j) and hit
                    bool seen = false
                    if sweptP.size() > 0
                        for m = 0 to sweptP.size() - 1
                            if sweptP.get(m) == p and sweptT.get(m) == ct
                                seen := true
                                break
                    if not seen
                        sweptP.push(p)
                        sweptT.push(ct)
                        int org = -1
                        if i_legMode == "Last 4H swing"
                            // last confirmed 4H swing low (high sweep) / swing high (low sweep) before the sweep candle j
                            int top = j - i_legPiv
                            int bot = B4.base + i_legPiv
                            if top >= bot
                                for m = top to bot
                                    bool isPiv = true
                                    for q2 = m - i_legPiv to m + i_legPiv
                                        if isHigh ? B4.L(q2) < B4.L(m) : B4.H(q2) > B4.H(m)
                                            isPiv := false
                                            break
                                    if isPiv
                                        org := m
                                        break
                        else
                            int lo = math.max(j - i_legLB, B4.base)
                            org := lo
                            for m = lo to j
                                if isHigh ? B4.L(m) < B4.L(org) : B4.H(m) > B4.H(org)
                                    org := m
                        if org >= 0
                            SW.push(Sweep.new(isHigh ? 1 : -1, j, org, p, tf))
    while sweptP.size() > 400
        sweptP.shift()
        sweptT.shift()

// rule 4: displacement AND (CISD or MSS) for an inversion at 4H candle j after a sweep at s
f_quality(int s, int j, bool sh) =>
    [dOk, dN, dAtr] = B4.disp(j, sh)
    int ext = s
    for k = s to j
        if sh ? B4.H(k) > B4.H(ext) : B4.L(k) < B4.L(ext)
            ext := k
    int sgn = sh ? -1 : 1
    // CISD: open of the first candle of the delivery run into the extreme
    bool cisd = false
    int d = math.sign(B4.C(ext) - B4.O(ext)) == -sgn ? ext : ext - 1
    int m = d
    while m >= B4.base
        if math.sign(B4.C(m) - B4.O(m)) == -sgn
            m -= 1
        else
            break
    if d >= B4.base and m < d
        float lv = B4.O(m + 1)
        for k = ext to j
            if sh ? B4.C(k) < lv : B4.C(k) > lv
                cisd := true
                break
    // MSS: last confirmed 4H swing (opposite side) before the extreme
    bool mss = false
    int p = -1
    int top = math.min(ext - 1, j - i_mssPiv)
    if top >= B4.base + i_mssPiv
        for k = top to B4.base + i_mssPiv
            if sh ? B4.pivLoAt(k, i_mssPiv, true) : B4.pivHiAt(k, i_mssPiv, true)
                p := k
                break
    if p >= 0
        float lv = sh ? B4.L(p) : B4.H(p)
        int st = math.max(ext, p + i_mssPiv + 1)
        if j >= st
            for k = st to j
                if sh ? B4.C(k) < lv : B4.C(k) > lv
                    mss := true
                    break
    string conf = cisd and mss ? "CISD+MSS" : cisd ? "CISD" : mss ? "MSS" : "-"
    bool passed = dOk and (cisd or mss)
    if useM1
        // M1: 1H MSS on the 1H swing before the 1H sweep extreme, from the 4H sweep candle to the 4H inversion close
        int s1 = -1
        int j1 = -1
        if B1.size() > B1.base
            for mm = B1.size() - 1 to B1.base
                int tm = B1.T(mm)
                if tm < B4.T(s)
                    break
                if tm < B4.TC(j)
                    if j1 < 0
                        j1 := mm
                    s1 := mm
        bool mss1 = false
        if s1 >= 0 and j1 >= s1
            int e1 = s1
            for mm = s1 to j1
                if sh ? B1.H(mm) > B1.H(e1) : B1.L(mm) < B1.L(e1)
                    e1 := mm
            mss1 := B1.mssHit(e1, j1, sh)
        conf := mss1 ? "1H MSS" : "-"
        passed := dOk and mss1
    [passed, dN, dAtr, conf, ext]

// 4H index of the candle containing time t (B4.size() = the candle still forming)
f_h4idx(int t) =>
    int r = B4.size()
    int last = B4.size() - 1
    if last >= B4.base
        if t < B4.TC(last)
            r := -1
            for m = last to B4.base
                if B4.T(m) <= t
                    r := m
                    break
    r

// swing: add newly confirmed D/W/M levels to the 1H level list (levels are confirmed in time order)
f_merge(array<float> P, array<int> T, bool isHi, string tf, int slot) =>
    if not na(P)
        if P.size() > 0
            for k = 0 to P.size() - 1
                int ct = T.get(k)
                if ct > haLast.get(slot)
                    haP.push(P.get(k))
                    haT.push(ct)
                    haHi.push(isHi)
                    haTf.push(tf)
                    haLast.set(slot, ct)
    while haP.size() > 300
        haP.shift()
        haT.shift()
        haHi.shift()
        haTf.shift()

// rule 7: high (short) / low (long) of the previous COMPLETED 1H candle beyond the price (looks back i_pcLB candles)
f_prev1h(bool sh, float px) =>
    float res = na
    int last = B1.size() - 1
    if last >= B1.base
        int first = math.max(B1.base, last - i_pcLB + 1)
        for m = last to first
            float v = sh ? B1.H(m) : B1.L(m)
            if (sh and v > px) or (not sh and v < px)
                res := v
                break
    res

// previous COMPLETED 4H candle beyond the price (B4 = completed 4H candles only)
f_prev4h(bool sh, float px) =>
    float res = na
    int last = B4.size() - 1
    if last >= B4.base
        int first = math.max(B4.base, last - i_pcLB + 1)
        for m = last to first
            float v = sh ? B4.H(m) : B4.L(m)
            if (sh and v > px) or (not sh and v < px)
                res := v
                break
    res

// 4H order block: high (short) of the last up-close 4H candle at or before 4H index `start` (low of the last
// down-close candle for a long), searching up to 30 candles back
f_ob4(int start, bool sh) =>
    float res = na
    int st = math.min(start, B4.size() - 1)
    if st >= B4.base
        for m = st to math.max(B4.base, st - 29)
            if sh ? B4.C(m) > B4.O(m) : B4.C(m) < B4.O(m)
                res := sh ? B4.H(m) : B4.L(m)
                break
    res

// swing stop: 50% of the 1H order block of the drop = first candle (last up-close 1H candle, short) of the first bearish
// 1H FVG formed by the drop from the sweep extreme (candle 3 after the extreme, candle 1 at or after the candle before
// it, complete, top above the 4H IFVG bottom). na = none (stop falls back to the sweep extreme)
// session end: is the completed-session extreme `price` a swing high/low on B1 (i_sessPiv each side)? 1H+ filter
f_sessSwing(float price, bool isHi) =>
    bool ok = false
    int n = i_sessPiv
    int last = B1.size() - 1 - n
    if last >= B1.base + n
        for i = last to B1.base + n
            bool piv = isHi ? B1.pivHiAt(i, n, true) : B1.pivLoAt(i, n, true)
            if piv and math.abs((isHi ? B1.H(i) : B1.L(i)) - price) <= price * 0.0002
                ok := true
                break
    ok

f_dropOb(bool sh, int anc, float bot4, float top4) =>
    float res = na
    int best = -1
    if F1.size() > 0 and anc >= 0
        for m = 0 to F1.size() - 1
            Fvg f = F1.get(m)
            if f.dir == (sh ? -1 : 1) and f.i3 > anc and f.i3 - 2 >= anc - 1 and (sh ? f.top > bot4 : f.bot < top4)
                if best < 0
                    best := m
                else if f.i3 < F1.get(best).i3
                    best := m
    if best >= 0
        int c1 = F1.get(best).i3 - 2
        int lo = math.max(c1 - 3, B1.base)
        if c1 >= lo
            for m = c1 to lo
                if sh ? B1.C(m) > B1.O(m) : B1.C(m) < B1.O(m)
                    res := (B1.H(m) + B1.L(m)) / 2
                    break
    res

// swing target: most recent confirmed 1H swing low (short; high for a long), 2 candles each side, before time t
f_swLow(int t, bool sh) =>
    float res = na
    int b = B1.size()
    while b - 1 >= B1.base
        if B1.T(b - 1) >= t
            b -= 1
        else
            break
    int top = math.min(b - 1, B1.size() - 3)
    if top >= B1.base + 2
        for i = top to B1.base + 2
            bool piv = true
            for k = i - 2 to i + 2
                if sh ? B1.L(k) < B1.L(i) : B1.H(k) > B1.H(i)
                    piv := false
                    break
            if piv
                res := sh ? B1.L(i) : B1.H(i)
                break
    res

// stop level (before the buffer) for the selected model / stop option; na = no valid stop
f_stopBase(bool sh, float px, float ext, float ob) =>
    string mode = isSwing ? i_swStop : i_inStop
    float base = mode == "Previous 1H candle" ? f_prev1h(sh, px) : mode == "Previous 4H candle" ? f_prev4h(sh, px) : mode == "4H order block" ? ob : mode == "1H OB 50%" ? (na(ob) ? ext : ob) : ext
    bool ok = not na(base) and (sh ? base > px : base < px)
    ok ? base : na

// entry / stop / target lines of a signal: stop extending, gray + dotted if the order never filled
method finishLines(Sig g) =>
    if not na(g.lnE)
        bool filled = g.fillIdx >= 0
        for ln in array.from(g.lnE, g.lnS, g.lnT)
            line.set_x2(ln, time)
            if not filled
                line.set_color(ln, color.new(color.gray, 30))
                line.set_style(ln, line.style_dotted)
        label.delete(g.lbE)
        label.delete(g.lbS)
        label.delete(g.lbT)

// close-back-through scan of the entry FVG on 5m closes from tStart: [cancelled, pending]
f_ctScan(float bot, float top, bool sh, int tStart) =>
    bool cancelled = false
    bool pending = false
    int n = ctC.size()
    int k = n - 1
    while k > 0
        if ctT.get(k - 1) >= tStart
            k -= 1
        else
            break
    if n > 0
        if ctT.get(k) < tStart
            k += 1
    while k < n
        float c = ctC.get(k)
        bool through = sh ? c > top : c < bot
        if through
            if k + 1 >= n
                pending := true
                break
            float c2 = ctC.get(k + 1)
            bool back = sh ? c2 < bot : c2 > top
            if back
                k += 2
                continue
            cancelled := true
            break
        k += 1
    [cancelled, pending]

// ───────────────────────────────────────────────────────────────────────────── 0. chart candle
BC.add(open, high, low, close, time, time_close, 4000)
int p = bar_index
updFvgs(FC, BC, p, 300)          // FVG completed by this candle is known at its close

if isM15
    if not na(a5c)
        if a5c.size() > 0
            for k = 0 to a5c.size() - 1
                ctC.push(a5c.get(k))
                ctT.push(a5t.get(k))
else
    ctC.push(close)
    ctT.push(time)
while ctC.size() > 3000
    ctC.shift()
    ctT.shift()

// ───────────────────────────────────────────────────────────────────────────── 1. new 1H candle (before fills: the 1H candle that just closed counts for the stop)
int q = -1
if new1
    B1.add(o1, h1, l1, c1, t1, tc1, 1500)
    q := B1.size() - 1
    updFvgs(F1, B1, q, 150)
    // ----- session highs/lows (intraday only): track the open session, push its extreme at the close (1H+ swing)
    if i_sess and not isSwing
        int nyh = hour(B1.T(q), "America/New_York")
        int cur = (nyh >= 20 or nyh < 0) ? 0 : (nyh >= 2 and nyh < 5) ? 1 : (nyh >= 7 and nyh < 10) ? 2 : -1
        if cur != sesId                                       // a session just ended / another began
            if sesId >= 0 and not na(sesHi)
                if f_sessSwing(sesHi, true)
                    lSHP.push(sesHi)
                    lSHT.push(B1.T(q))
                if f_sessSwing(sesLo, false)
                    lSLP.push(sesLo)
                    lSLT.push(B1.T(q))
                while lSHP.size() > 60
                    lSHP.shift()
                    lSHT.shift()
                while lSLP.size() > 60
                    lSLP.shift()
                    lSLT.shift()
            sesId := cur
            sesHi := cur >= 0 ? B1.H(q) : na
            sesLo := cur >= 0 ? B1.L(q) : na
        else if cur >= 0
            sesHi := math.max(sesHi, B1.H(q))
            sesLo := math.min(sesLo, B1.L(q))

// ───────────────────────────────────────────────────────────────────────────── 2. virtual fills / exits (orders were set on the previous candle)
if SG.size() > 0
    for k = 0 to SG.size() - 1
        Sig g = SG.get(k)
        if g.state == 1 and p >= g.liveFrom and g.liveFrom >= 0
            bool expired = time >= g.trigT + (isSwing ? i_swValid : i_fillHrs) * HOUR
            bool gapOut = g.sh ? open > g.hiPx : open < g.hiPx
            if expired or g.cancelled
                g.state := 3
                g.result := expired ? "expired" : "cancelled"
            else if gapOut
                g.state := 3
                g.result := "cancelled (gap beyond retest extreme)"
            else if not g.blocked and (g.sh ? high >= g.lvl : low <= g.lvl)
                g.entry := g.sh ? math.max(g.lvl, open) : math.min(g.lvl, open)
                if isSwing and i_swStop == "1H OB 50%"
                    g.ob := f_dropOb(g.sh, g.anc, g.bot, g.top)
                float pc1 = f_stopBase(g.sh, g.entry, g.ext, g.ob)
                if na(pc1)
                    g.state := 3
                    g.result := "no valid stop beyond entry"
                    continue
                g.sl := g.sh ? pc1 + i_slBuf : pc1 - i_slBuf
                g.risk := math.abs(g.entry - g.sl)
                g.tp := g.sh ? g.entry - i_tgtR * g.risk : g.entry + i_tgtR * g.risk
                if isSwing and i_swTgt == "1H swing low"
                    g.tp := g.tpFix
                if na(g.tp) or (g.sh ? g.tp >= g.entry : g.tp <= g.entry)
                    g.state := 3
                    g.result := "no 1H swing low target beyond entry"
                    continue
                g.fillIdx := p
                g.state := 2
                alert(syminfo.ticker + " " + (g.sh ? "SHORT" : "LONG") + " filled @ " + str.tostring(g.entry, format.mintick), alert.freq_once_per_bar_close)
        if g.state == 2
            bool hitSL = g.sh ? high >= g.sl : low <= g.sl
            bool hitTP = (g.sh ? low <= g.tp : high >= g.tp) and p > g.fillIdx
            if hitSL or hitTP
                float exitPx = hitSL ? g.sl : g.tp
                float pnl = g.sh ? g.entry - exitPx : exitPx - g.entry
                float r = (pnl - i_cost) / g.risk
                bool isBE = hitSL and g.beDone
                nTrades += 1
                nWins += hitSL ? 0 : 1
                nLoss += hitSL and not isBE ? 1 : 0
                nBE += isBE ? 1 : 0
                sumR += r
                grossW += r > 0 ? r : 0.0
                grossL += r < 0 ? -r : 0.0
                holdH += (time - BC.T(g.fillIdx)) / 3600000.0
                g.state := 3
                g.result := isBE ? "breakeven" : hitSL ? "stop" : "target"
                if i_showE
                    label.new(time, exitPx, (isBE ? "BE " : hitSL ? "SL " : "TP ") + str.tostring(r, "+0.00;-0.00") + "R", xloc=xloc.bar_time, style=label.style_label_left, color=isBE ? color.gray : hitSL ? color.red : color.teal, textcolor=color.white, size=size.tiny)
                    line.new(BC.T(g.fillIdx), g.entry, time, exitPx, xloc=xloc.bar_time, color=color.gray, style=line.style_dotted)
                alert(syminfo.ticker + " trade closed: " + g.result + " " + str.tostring(r, "+0.00;-0.00") + "R", alert.freq_once_per_bar_close)
            else if i_be and not g.beDone and p > g.fillIdx and (g.sh ? g.entry - low : high - g.entry) >= i_beR * g.risk
                g.sl := g.entry
                g.beDone := true
                alert(syminfo.ticker + " stop moved to breakeven " + str.tostring(g.entry, format.mintick), alert.freq_once_per_bar_close)

// ───────────────────────────────────────────────────────────────────────────── 3. new 4H candle: sweeps -> IFVG -> quality (rules 1-4)
if new4
    B4.add(o4, h4, l4, c4, t4, tc4, 600)
    int j = B4.size() - 1
    updFvgs(F4, B4, j, 120)
    if i_useD and not useHa
        f_sweeps(dHp, dHt, true, "D", j)
        f_sweeps(dLp, dLt, false, "D", j)
    if i_useW and not useHa
        f_sweeps(wHp, wHt, true, "W", j)
        f_sweeps(wLp, wLt, false, "W", j)
    if i_useM and not useHa
        f_sweeps(mHp, mHt, true, "M", j)
        f_sweeps(mLp, mLt, false, "M", j)
    // 4H liquidity: intraday sweeps these 4H levels here (swing sweeps them on 1H in section 3b). Either way, keep the
    // l4HP/l4LP list current: drop levels broken by this 4H candle, then add a swing confirmed now.
    if i_liq4 > 0
        if not useHa
            f_sweeps(l4HP, l4HT, true, "4H", j)
            f_sweeps(l4LP, l4LT, false, "4H", j)
        if l4HP.size() > 0
            for k = l4HP.size() - 1 to 0
                if l4HT.get(k) <= B4.T(j) and B4.H(j) > l4HP.get(k)
                    l4HP.remove(k)
                    l4HT.remove(k)
        if l4LP.size() > 0
            for k = l4LP.size() - 1 to 0
                if l4LT.get(k) <= B4.T(j) and B4.L(j) < l4LP.get(k)
                    l4LP.remove(k)
                    l4LT.remove(k)
        int pv4 = j - i_liq4
        if pv4 - i_liq4 >= B4.base
            if B4.pivHiAt(pv4, i_liq4, true)
                l4HP.push(B4.H(pv4))
                l4HT.push(B4.TC(j))
            if B4.pivLoAt(pv4, i_liq4, true)
                l4LP.push(B4.L(pv4))
                l4LT.push(B4.TC(j))
        while l4HP.size() > 100
            l4HP.shift()
            l4HT.shift()
        while l4LP.size() > 100
            l4LP.shift()
            l4LT.shift()
    // session liquidity (intraday): sweep, then drop broken levels
    if i_sess and not useHa
        f_sweeps(lSHP, lSHT, true, "SESS", j)
        f_sweeps(lSLP, lSLT, false, "SESS", j)
        if lSHP.size() > 0
            for k = lSHP.size() - 1 to 0
                if lSHT.get(k) <= B4.T(j) and B4.H(j) > lSHP.get(k)
                    lSHP.remove(k)
                    lSHT.remove(k)
        if lSLP.size() > 0
            for k = lSLP.size() - 1 to 0
                if lSLT.get(k) <= B4.T(j) and B4.L(j) < lSLP.get(k)
                    lSLP.remove(k)
                    lSLT.remove(k)
    if SW.size() > 0
        for k = SW.size() - 1 to 0
            Sweep sw = SW.get(k)
            if sw.done or j - sw.s > i_invWin
                SW.remove(k)
                continue
            bool sh = sw.dir == 1
            int want = sh ? 1 : -1
            // candidates: FVGs of the leg inverted on this candle, nearest to price first
            array<int> cand = array.new_int()
            if F4.size() > 0
                for m = 0 to F4.size() - 1
                    Fvg f = F4.get(m)
                    if f.dir == want and f.inv == j and f.i3 - 2 >= sw.origin and (not i_fvgInto or f.i3 - 1 <= sw.s)
                        cand.push(m)
            while cand.size() > 0 and not sw.done
                int bi = 0
                for m = 0 to cand.size() - 1
                    Fvg fa = F4.get(cand.get(m))
                    Fvg fb = F4.get(cand.get(bi))
                    if sh ? fa.bot < fb.bot : fa.top > fb.top
                        bi := m
                Fvg f = F4.get(cand.get(bi))
                cand.remove(bi)
                [ok, dN, dAtr, conf, ext] = f_quality(sw.s, j, sh)
                if ok
                    sw.done := true
                    // skip if this IFVG already produced a setup (several levels swept by one leg)
                    bool dup = false
                    if ST.size() > 0
                        for m = 0 to ST.size() - 1
                            Setup o = ST.get(m)
                            if o.sigT == B4.TC(j) and o.top == f.top and o.bot == f.bot
                                dup := true
                    if not dup
                        // locate the sweep extreme on 1H
                        int extT = B4.T(ext)
                        int anc = -1
                        if B1.size() > B1.base
                            for m = B1.size() - 1 to B1.base
                                int tm = B1.T(m)
                                if tm < extT
                                    break
                                if tm < extT + 4 * HOUR
                                    if anc < 0
                                        anc := m
                                    else if sh ? B1.H(m) > B1.H(anc) : B1.L(m) < B1.L(anc)
                                        anc := m
                        if anc >= 0
                            string info = sw.tf + (sh ? "H " : "L ") + str.tostring(sw.price, format.mintick) + " swept | 4H " + conf + " | disp " + str.tostring(dN) + "c " + str.tostring(dAtr, "0.0") + " ATR"
                            Setup nst = Setup.new(sh, f.top, f.bot, B4.TC(j), sh ? B1.H(anc) : B1.L(anc), anc, info, 0, array.new_int(), array.new_int(), -10)
                            nst.ob := f_ob4(dN > 0 ? j - dN : j, sh)     // last opposite candle before the 4H displacement
                            ST.push(nst)
                            n4 += 1
                            if i_show4
                                box.new(B4.T(f.i3 - 2), f.top, B4.TC(j) + 24 * HOUR, f.bot, xloc=xloc.bar_time, border_color=sh ? color.red : color.teal, bgcolor=sh ? cBear : cBull, text="4H IFVG", text_size=size.tiny, text_color=color.gray)
                                label.new(B4.TC(j), sh ? B4.H(j) : B4.L(j), "4H " + (sh ? "short" : "long") + "\n" + info, xloc=xloc.bar_time, style=sh ? label.style_label_down : label.style_label_up, color=sh ? color.red : color.teal, textcolor=color.white, size=size.tiny)
                            alert(syminfo.ticker + " 4H setup " + (sh ? "SHORT" : "LONG") + ": " + info, alert.freq_once_per_bar_close)

// ───────────────────────────────────────────────────────────────────────────── 3b. SWING model (snapshot rules) on the new 1H candle
if new1 and useHa
    if i_useD
        f_merge(dHp, dHt, true, "D", 0)
        f_merge(dLp, dLt, false, "D", 1)
    if i_useW
        f_merge(wHp, wHt, true, "W", 2)
        f_merge(wLp, wLt, false, "W", 3)
    if i_useM
        f_merge(mHp, mHt, true, "M", 4)
        f_merge(mLp, mLt, false, "M", 5)
    if i_liq4 > 0
        f_merge(l4HP, l4HT, true, "4H", 6)
        f_merge(l4LP, l4LT, false, "4H", 7)
    // sweeps on this 1H candle (each level once: removed when swept)
    if haP.size() > 0
        for k = haP.size() - 1 to 0
            float pr = haP.get(k)
            bool hiL = haHi.get(k)
            if haT.get(k) <= B1.T(q) and (hiL ? B1.H(q) > pr : B1.L(q) < pr)
                SW1.push(Sweep1.new(hiL ? 1 : -1, q, f_h4idx(B1.T(q)), pr, haTf.get(k)))
                haP.remove(k)
                haT.remove(k)
                haHi.remove(k)
                haTf.remove(k)
    if SW1.size() > 0
        for k = SW1.size() - 1 to 0
            Sweep1 sw = SW1.get(k)
            if sw.done or q - sw.s1 > i_haWin
                SW1.remove(k)
                continue
            bool sh = sw.dir == 1
            int want = sh ? 1 : -1
            // rule 2 FVG: the LAST intact 4H FVG of the sweeping leg that is already complete at this 1H candle
            int fi = -1
            if F4.size() > 0
                for m = F4.size() - 1 to 0
                    Fvg f = F4.get(m)
                    bool ok = f.dir == want and f.i3 - 1 <= sw.s4 and f.i3 - 2 >= sw.s4 - i_haLB and f.i3 - 2 >= B4.base
                    if ok
                        ok := B4.TC(f.i3) <= B1.T(q)
                    if ok and sw.s1 - 1 >= B1.base
                        int tDone = B4.TC(f.i3)
                        for r = sw.s1 - 1 to B1.base
                            if B1.T(r) < tDone
                                break
                            if sh ? B1.C(r) < f.bot : B1.C(r) > f.top
                                ok := false
                                break
                    if ok
                        fi := m
                        break
            if fi >= 0
                Fvg f = F4.get(fi)
                if sh ? B1.C(q) < f.bot : B1.C(q) > f.top
                    // first 1H CLOSE through it: final for this sweep
                    sw.done := true
                    [dOk, dN, dAtr] = B1.disp(q, sh, i_dMin1)
                    int e1 = sw.s1
                    for m = sw.s1 to q
                        if sh ? B1.H(m) > B1.H(e1) : B1.L(m) < B1.L(e1)
                            e1 := m
                    bool mss = B1.mssHit(e1, q, sh)
                    int key = want * (f.i3 + 1)
                    if dOk and mss and not haKeys.includes(key)
                        haKeys.push(key)
                        while haKeys.size() > 200
                            haKeys.shift()
                        float ext1 = sh ? B1.H(e1) : B1.L(e1)
                        string info = sw.tf + (sh ? "H " : "L ") + str.tostring(sw.price, format.mintick) + " swept | 4H FVG inverted by 1H close + 1H MSS | disp " + str.tostring(dN) + "c " + str.tostring(dAtr, "0.0") + " ATR"
                        string sid = (sh ? "S" : "L") + str.tostring(B1.TC(q))
                        Sig nsw = Sig.new(sh, f.top, f.bot, B1.TC(q), ext1, info, sid, 0, -1, -1, -10, array.new<Rt>())
                        nsw.anc := e1
                        nsw.tpFix := f_swLow(B4.T(f.i3 - 1), sh)        // 1H swing low before the 4H FVG's middle candle
                        SG.push(nsw)
                        n4 += 1
                        n1 += 1
                        if i_show4
                            box.new(B4.T(f.i3 - 2), f.top, B1.TC(q) + 48 * HOUR, f.bot, xloc=xloc.bar_time, border_color=sh ? color.red : color.teal, bgcolor=sh ? cBear : cBull, text="4H IFVG", text_size=size.tiny, text_color=color.gray)
                            label.new(B1.TC(q), sh ? B1.H(q) : B1.L(q), "SWING " + (sh ? "short" : "long") + "\n" + info, xloc=xloc.bar_time, style=sh ? label.style_label_down : label.style_label_up, color=sh ? color.red : color.teal, textcolor=color.white, size=size.tiny)
                        alert(syminfo.ticker + " SWING setup " + (sh ? "SHORT" : "LONG") + ": " + info, alert.freq_once_per_bar_close)

// ───────────────────────────────────────────────────────────────────────────── 4. rule 5 on the new 1H candle
if new1 and ST.size() > 0
    for k = ST.size() - 1 to 0
        Setup st = ST.get(k)
        if st.state != 0
            ST.remove(k)
            continue
        int tq = B1.T(q)
        if tq < st.sigT
            continue
        bool sh = st.sh
        if sh ? B1.H(q) > st.ext : B1.L(q) < st.ext
            st.state := 2
            continue
        bool inWin = tq < st.sigT + i_rt4Hrs * HOUR
        float edge = sh ? st.bot : st.top
        bool touch = inWin and (sh ? B1.H(q) >= edge : B1.L(q) <= edge)
        if touch
            if st.lastTouch != q - 1
                int org = st.anchor
                for m = st.anchor to q
                    if sh ? B1.L(m) < B1.L(org) : B1.H(m) > B1.H(org)
                        org := m
                st.rtI.push(q)
                st.rtO.push(org)
            st.lastTouch := q
        bool anyOpen = false
        int pick = -1
        if st.rtI.size() > 0
            [dOk, dN, dAtr] = B1.disp(q, sh)
            for r = 0 to st.rtI.size() - 1
                int ri = st.rtI.get(r)
                if q - ri <= i_inv1
                    anyOpen := true
                    if dOk and pick < 0 and F1.size() > 0
                        for m = 0 to F1.size() - 1
                            Fvg f = F1.get(m)
                            if f.dir == (sh ? 1 : -1) and f.inv == q and f.i3 - 2 >= st.rtO.get(r) and f.i3 < q
                                if pick < 0
                                    pick := m
                                else
                                    Fvg fb = F1.get(pick)
                                    if sh ? f.bot < fb.bot : f.top > fb.top
                                        pick := m
            bool dupSig = false
            if pick >= 0 and SG.size() > 0
                Fvg fd = F1.get(pick)
                for m = 0 to SG.size() - 1
                    Sig gd = SG.get(m)
                    if gd.sh == sh and gd.sigT == B1.TC(q) and gd.top == fd.top and gd.bot == fd.bot
                        dupSig := true
            if pick >= 0 and dupSig
                st.state := 1
            else if pick >= 0
                Fvg f = F1.get(pick)
                st.state := 1
                n1 += 1
                string sid = (sh ? "S" : "L") + str.tostring(B1.TC(q))
                string inf = st.info + "\n1H IFVG " + str.tostring(f.bot, format.mintick) + "-" + str.tostring(f.top, format.mintick) + " | disp " + str.tostring(dN) + "c " + str.tostring(dAtr, "0.0") + " ATR"
                Sig nsg = Sig.new(sh, f.top, f.bot, B1.TC(q), st.ext, inf, sid, 0, -1, -1, -10, array.new<Rt>())
                nsg.ob := st.ob
                SG.push(nsg)
                if i_show1
                    box.new(B1.T(f.i3 - 2), f.top, B1.TC(q) + 12 * HOUR, f.bot, xloc=xloc.bar_time, border_color=sh ? color.red : color.teal, bgcolor=color.new(sh ? color.red : color.teal, 55), text="1H IFVG", text_size=size.tiny, text_color=color.white)
                alert(syminfo.ticker + " 1H IFVG " + (sh ? "SHORT" : "LONG") + " signal", alert.freq_once_per_bar_close)
        if st.state == 0 and not inWin and not anyOpen
            st.state := 2

// ───────────────────────────────────────────────────────────────────────────── 5. rule 6 on the chart candle
if tfOK and SG.size() > 0
    for k = SG.size() - 1 to 0
        Sig g = SG.get(k)
        if g.state == 3
            g.finishLines()
            SG.remove(k)
            continue
        bool sh = g.sh
        if g.s0 < 0
            g.s0 := p
            g.sPre := BC.firstAtOrAfter(g.sigT - HOUR)
        // ── SWING model: limit at the 1H IFVG straight after the 1H signal (no rule 6)
        if isSwing and g.state == 0
            g.lvl := i_swEntry == "4H IFVG Touch" ? (sh ? g.bot : g.top) : (g.top + g.bot) / 2
            g.hiPx := g.ext
            g.trig := p
            g.trigT := g.sigT
            g.trigBy := "4H IFVG"
            g.fI3 := p
            g.fTop := g.top
            g.fBot := g.bot
            g.liveFrom := p + 1
            g.state := 1
            if i_showE
                line.new(time, g.lvl, g.sigT + i_swValid * HOUR, g.lvl, xloc=xloc.bar_time, color=color.orange, width=2)
                label.new(time, g.lvl, "swing " + i_swEntry, xloc=xloc.bar_time, style=label.style_none, textcolor=color.orange, size=size.tiny)
        // ── INTRADAY model: retest + trigger
        if g.state == 0 and not isSwing
            if sh ? high > g.ext : low < g.ext
                g.state := 3
                g.result := "invalidated"
                continue
            bool inWin = time < g.sigT + i_rt1Hrs * HOUR
            float edge = sh ? g.bot : g.top
            bool touch = inWin and (sh ? high >= edge : low <= edge)
            if touch and g.lastTouch != p - 1
                int org = g.sPre
                for m = g.sPre to p
                    if sh ? BC.L(m) < BC.L(org) : BC.H(m) > BC.H(org)
                        org := m
                g.rts.push(Rt.new(p, org, p, time + i_trgHrs * HOUR))
            if touch
                g.lastTouch := p
            int trigIdx = -1
            int trigT = 0
            string trigBy = ""
            float trigLv = na
            int trigR = -1
            // (a) 1H CISD - the 1H candle that just completed is known at the open of this chart candle
            if i_cisd and new1 and g.rts.size() > 0
                for r = 0 to g.rts.size() - 1
                    Rt rt = g.rts.get(r)
                    if rt.q0 < 0 and B1.T(q) >= BC.T(rt.r) - BC.T(rt.r) % HOUR
                        rt.q0 := q
                        rt.e := q
                    if rt.q0 >= 0 and B1.T(q) < rt.tEnd and trigIdx < 0
                        if sh ? B1.H(q) > B1.H(rt.e) : B1.L(q) < B1.L(rt.e)
                            rt.e := q
                        else
                            int e = rt.e
                            bool bullE = sh ? B1.C(e) > B1.O(e) : B1.C(e) < B1.O(e)
                            int d = bullE ? e : e - 1
                            int m = d
                            while m >= B1.base
                                bool bm = sh ? B1.C(m) > B1.O(m) : B1.C(m) < B1.O(m)
                                if bm
                                    m -= 1
                                else
                                    break
                            if d >= B1.base and m < d
                                float lv = B1.O(m + 1)
                                [dOk1, dN1, dA1] = B1.disp(q, sh)
                                if (sh ? B1.C(q) < lv : B1.C(q) > lv) and dOk1
                                    trigIdx := p - 1
                                    trigT := B1.TC(q)
                                    trigBy := "1H CISD"
                                    trigLv := lv
                                    trigR := rt.r
            // (b) MSS on the chart timeframe
            if trigIdx < 0 and g.rts.size() > 0
                [dOkC, dNC, dAC] = BC.disp(p, sh)
                for r = 0 to g.rts.size() - 1
                    Rt rt = g.rts.get(r)
                    if time >= rt.tEnd or trigIdx >= 0
                        continue
                    if sh ? high > BC.H(rt.rh) : low < BC.L(rt.rh)
                        rt.rh := p
                        continue
                    array<int> piv = sh ? PLc : PHc
                    float lv = na
                    if piv.size() > 0
                        for m = piv.size() - 1 to 0
                            int pi = piv.get(m)
                            if pi < rt.rh and pi + i_ltfPiv < p
                                if pi >= rt.origin
                                    lv := sh ? BC.L(pi) : BC.H(pi)
                                break
                    if not na(lv) and (sh ? close < lv : close > lv) and dOkC
                        trigIdx := p
                        trigT := time_close
                        trigBy := "MSS"
                        trigLv := lv
                        trigR := rt.r
            if trigIdx >= 0
                int hiI = trigR
                for m = trigR to trigIdx
                    if sh ? BC.H(m) > BC.H(hiI) : BC.L(m) < BC.L(hiI)
                        hiI := m
                g.trig := trigIdx
                g.trigT := trigT
                g.trigBy := trigBy
                g.trigLv := trigLv
                g.hi := hiI
                g.hiPx := sh ? BC.H(hiI) : BC.L(hiI)
                g.state := 1
                if i_showE
                    line.new(BC.T(math.max(trigR - 5, BC.base)), trigLv, time, trigLv, xloc=xloc.bar_time, color=color.purple, width=1, style=line.style_dashed)
                    label.new(time, trigLv, trigBy, xloc=xloc.bar_time, style=label.style_none, textcolor=color.purple, size=size.tiny)
            else if not inWin and g.rts.size() > 0
                bool open_ = false
                for r = 0 to g.rts.size() - 1
                    if time < g.rts.get(r).tEnd
                        open_ := true
                if not open_
                    g.state := 3
                    g.result := "no trigger"
            else if not inWin and g.rts.size() == 0
                g.state := 3
                g.result := "no retest"
        // ── entry FVG + order (state 1, not filled yet)
        if g.state == 1
            // choose / refine the entry FVG while it may still complete (up to i_fvgAft candles after the trigger)
            if not isSwing and p <= g.trig + i_fvgAft
                int want = sh ? -1 : 1
                int best = -1
                int bestD = 0
                if FC.size() > 0
                    for m = 0 to FC.size() - 1
                        Fvg f = FC.get(m)
                        if f.dir == want and f.i3 - 2 >= g.hi and f.i3 <= g.trig + i_fvgAft and f.i3 <= p
                            int dd = math.abs(f.i3 - 1 - g.trig)
                            if best < 0 or dd < bestD
                                best := m
                                bestD := dd
                if best >= 0
                    Fvg f = FC.get(best)
                    if f.i3 != g.fI3
                        g.fI3 := f.i3
                        g.fTop := f.top
                        g.fBot := f.bot
                        g.lvl := i_entry == "5m Touch" ? (sh ? f.bot : f.top) : (f.top + f.bot) / 2
                        g.liveFrom := math.max(g.trig, f.i3) + 1
                        if i_showE
                            box.new(BC.T(f.i3 - 2), f.top, BC.TC(f.i3) + i_fillHrs * HOUR, f.bot, xloc=xloc.bar_time, border_color=color.orange, bgcolor=color.new(color.orange, 80), text="entry FVG", text_size=size.tiny, text_color=color.orange)
                        alert(syminfo.ticker + " " + (sh ? "SHORT" : "LONG") + " order " + str.tostring(g.lvl, format.mintick) + " SL " + str.tostring(g.sl, format.mintick) + " TP " + str.tostring(g.tp, format.mintick) + " (" + g.trigBy + ")", alert.freq_once_per_bar_close)
            else if g.fI3 < 0
                g.state := 3
                g.result := "trigger, no FVG"
            // preliminary stop / target for the pending order (final values are set at the fill)
            if g.fI3 >= 0 and g.state == 1
                if isSwing and i_swStop == "1H OB 50%"
                    g.ob := f_dropOb(sh, g.anc, g.bot, g.top)
                float pc0 = f_stopBase(sh, g.lvl, g.ext, g.ob)
                g.sl := na(pc0) ? na : sh ? pc0 + i_slBuf : pc0 - i_slBuf
                g.tp := na(pc0) ? na : sh ? g.lvl - i_tgtR * (g.sl - g.lvl) : g.lvl + i_tgtR * (g.lvl - g.sl)
                if isSwing and i_swTgt == "1H swing low"
                    g.tp := g.tpFix
            if isSwing and g.state == 1 and p == g.trig and not na(g.sl)
                alert(syminfo.ticker + " SWING " + (sh ? "SHORT" : "LONG") + " order " + str.tostring(g.lvl, format.mintick) + " SL " + str.tostring(g.sl, format.mintick) + " TP " + str.tostring(g.tp, format.mintick), alert.freq_once_per_bar_close)
            // close-back-through rule on 5m closes (state for the NEXT candle) - intraday only
            if g.fI3 >= 0 and g.state == 1
                g.blocked := false
                if i_ct and not isSwing
                    [cx, pend] = f_ctScan(g.fBot, g.fTop, sh, BC.TC(g.fI3))
                    g.cancelled := cx
                    g.blocked := pend

// ───────────────────────────────────────────────────────────────────────────── 5b. entry / stop / target levels on the chart
var string actTxt = "-"
actTxt := "-"
if i_showE and tfOK and SG.size() > 0
    for k = 0 to SG.size() - 1
        Sig g = SG.get(k)
        if (g.state == 1 or g.state == 2) and not na(g.lvl) and not na(g.sl) and not na(g.tp)
            float ePx = g.state == 2 ? g.entry : g.lvl
            string side = g.sh ? "SHORT" : "LONG"
            string stx = g.state == 2 ? "OPEN" : "PENDING"
            if na(g.lnE)
                g.lnE := line.new(time, ePx, time + 1, ePx, xloc=xloc.bar_time, color=color.orange, width=2)
                g.lnS := line.new(time, g.sl, time + 1, g.sl, xloc=xloc.bar_time, color=color.red, width=2)
                g.lnT := line.new(time, g.tp, time + 1, g.tp, xloc=xloc.bar_time, color=color.teal, width=2)
                g.lbE := label.new(time, ePx, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.orange, 15), textcolor=color.white, size=size.small)
                g.lbS := label.new(time, g.sl, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.red, 15), textcolor=color.white, size=size.small)
                g.lbT := label.new(time, g.tp, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.teal, 15), textcolor=color.white, size=size.small)
            line.set_y1(g.lnE, ePx)
            line.set_y2(g.lnE, ePx)
            line.set_x2(g.lnE, time)
            line.set_y1(g.lnS, g.sl)
            line.set_y2(g.lnS, g.sl)
            line.set_x2(g.lnS, time)
            line.set_y1(g.lnT, g.tp)
            line.set_y2(g.lnT, g.tp)
            line.set_x2(g.lnT, time)
            label.set_xy(g.lbE, time, ePx)
            label.set_text(g.lbE, side + " " + stx + "  entry " + str.tostring(ePx, format.mintick))
            label.set_xy(g.lbS, time, g.sl)
            label.set_text(g.lbS, "SL " + str.tostring(g.sl, format.mintick) + (g.beDone ? "  (breakeven)" : ""))
            label.set_xy(g.lbT, time, g.tp)
            label.set_text(g.lbT, "TP " + str.tostring(g.tp, format.mintick) + "  (" + (isSwing and i_swTgt == "1H swing low" ? "1H swing low, " + str.tostring(math.abs(g.tp - (g.state == 2 ? g.entry : g.lvl)) / math.max(math.abs((g.state == 2 ? g.entry : g.lvl) - g.sl), syminfo.mintick), "0.0") + "R" : str.tostring(i_tgtR) + "R") + ")")
            actTxt := side + " " + stx + "  E " + str.tostring(ePx, format.mintick) + " / SL " + str.tostring(g.sl, format.mintick) + " / TP " + str.tostring(g.tp, format.mintick)

// ───────────────────────────────────────────────────────────────────────────── 6. chart-TF swings (usable from the next candle)
int pc = p - i_ltfPiv
if pc >= BC.base + i_ltfPiv
    if BC.pivLoAt(pc, i_ltfPiv, false)
        PLc.push(pc)
    if BC.pivHiAt(pc, i_ltfPiv, false)
        PHc.push(pc)
while PLc.size() > 400
    PLc.shift()
while PHc.size() > 400
    PHc.shift()

// ───────────────────────────────────────────────────────────────────────────── 7. broker orders (strategy only)
//#S if SG.size() > 0
//#S     for k = 0 to SG.size() - 1
//#S         Sig g = SG.get(k)
//#S         if g.state == 1 and g.fI3 >= 0
//#S             bool liveNext = p + 1 >= g.liveFrom and not g.cancelled and not g.blocked and time_close < g.trigT + (isSwing ? i_swValid : i_fillHrs) * HOUR and not na(g.sl)
//#S             if liveNext
//#S                 float riskPx = math.abs(g.lvl - g.sl)
//#S                 float qty = math.floor(strategy.equity * i_risk / 100 / (riskPx * syminfo.pointvalue) / i_qtyStep) * i_qtyStep
//#S                 if qty > 0
//#S                     strategy.entry(g.id, g.sh ? strategy.short : strategy.long, qty=qty, limit=g.lvl)
//#S                     strategy.exit(g.id + " x", from_entry=g.id, stop=g.sl, limit=g.tp)
//#S             else
//#S                 strategy.cancel(g.id)
//#S         else if g.state == 2
//#S             strategy.cancel(g.id)
//#S             strategy.exit(g.id + " x", from_entry=g.id, stop=g.sl, limit=g.tp)
//#S         else if g.state == 3
//#S             strategy.cancel(g.id)

// ───────────────────────────────────────────────────────────────────────────── 8. levels + table
var array<line> lvLines = array.new<line>()
f_drawLv(array<float> P, array<int> T, color col, string tag) =>
    if not na(P)
        if P.size() > 0
            for k = 0 to P.size() - 1
                lvLines.push(line.new(T.get(k), P.get(k), time + 1, P.get(k), xloc=xloc.bar_time, extend=extend.right, color=col, width=tag == "M" ? 3 : tag == "W" ? 2 : 1))

if barstate.islast
    for ln in lvLines
        line.delete(ln)
    lvLines.clear()
    if i_showLv
        if i_useM
            f_drawLv(mHp, mHt, color.new(color.purple, 20), "M")
            f_drawLv(mLp, mLt, color.new(color.purple, 20), "M")
        if i_useW
            f_drawLv(wHp, wHt, color.new(color.blue, 30), "W")
            f_drawLv(wLp, wLt, color.new(color.blue, 30), "W")
        if i_useD
            f_drawLv(dHp, dHt, color.new(color.orange, 40), "D")
            f_drawLv(dLp, dLt, color.new(color.orange, 40), "D")
        if i_liq4 > 0
            f_drawLv(l4HP, l4HT, color.new(color.gray, 40), "4H")
            f_drawLv(l4LP, l4LT, color.new(color.gray, 40), "4H")
        if i_sess and not isSwing
            f_drawLv(lSHP, lSHT, color.new(color.teal, 30), "S")
            f_drawLv(lSLP, lSLT, color.new(color.teal, 30), "S")

var table tb = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast and i_table
    table.cell(tb, 0, 0, not symOK ? "Not a US100 chart - trading off" : tfOK ? (isSwing ? "SWING model - entry" : "INTRADAY model - entry") : (isSwing ? "Use a 5m (or 1H) chart" : "Use a 5m chart"), text_color=tfOK ? color.white : color.yellow, text_size=size.small)
    table.cell(tb, 1, 0, isSwing ? i_swEntry : i_entry, text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, isSwing ? "Swing setups (4H IFVG by 1H close)" : useM1 ? "4H setups (rule 3 M1)" : "4H setups", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, str.tostring(n4), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, isSwing ? "Swing signals" : "1H IFVG signals", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(n1), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "Trades (W / L / BE)", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(nTrades) + " (" + str.tostring(nWins) + " / " + str.tostring(nLoss) + " / " + str.tostring(nBE) + ")", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, "Win rate", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 4, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "0.0") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 5, "Total R (after cost)", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 5, str.tostring(sumR, "+0.00;-0.00"), text_color=sumR >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(tb, 0, 6, "History from", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 6, str.format_time(BC.T(BC.base), "yyyy-MM-dd", syminfo.timezone), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 7, "Open setups / orders", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 7, str.tostring(ST.size()) + " / " + str.tostring(SG.size()), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 8, "Profit factor", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 8, grossL > 0 ? str.tostring(grossW / grossL, "0.00") : nTrades > 0 ? "no losses" : "-", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 9, "Avg hold", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 9, nTrades > 0 ? str.tostring(holdH / nTrades, "0.0") + " h" : "-", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 10, "Stop / target", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 10, (isSwing ? i_swStop : i_inStop) + " / " + (isSwing and i_swTgt == "1H swing low" ? "1H swing low" : str.tostring(i_tgtR) + "R") + (i_be ? ", BE +" + str.tostring(i_beR) + "R" : ""), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 11, "Active trade", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 11, actTxt, text_color=actTxt == "-" ? color.white : color.yellow, text_size=size.small)
