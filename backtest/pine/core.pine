//#N i_tgt5 = input.string("Fixed R", "Intraday target", options=["Fixed R", "Major 5m swing"], group=gR, tooltip="Fixed R = 'Target (R)' x risk. Major 5m swing = the nearest confirmed 5m swing low (short) / high (long) with 10 candles each side beyond the entry; none -> 3R.")

