//#N i_rev5 = input.int(30, "Intraday: max 5m candles from the sweep to the reversal (N)", minval=1, group=gR, tooltip="The 5m IFVG and the 5m break of structure must both happen within this many 5m candles of the sweep.")
//#N i_fvgAft  = input.int(2, "Entry FVG / volume imbalance may complete N candles after the reversal", minval=0, group=gR)
