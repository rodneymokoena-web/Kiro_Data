i_piv    = input.int(2, "Swing size (candles each side)", minval=1, maxval=5, group=g1)
i_useD   = input.bool(true, "Daily", inline="tf", group=g1)
i_useW   = input.bool(true, "Weekly", inline="tf", group=g1)
i_useM   = input.bool(true, "Monthly", inline="tf", group=g1)
i_showLv = input.bool(true, "Show unbroken levels", group=g1)
i_liq4   = input.int(10, "4H swings (candles each side, 0 = off)", minval=0, maxval=30, group=g1, tooltip="Liquidity = 4H/D/W/M for BOTH models: 4H swing highs/lows with this many candles each side (only the significant ones), usable once confirmed, plus the D/W/M swings.")
i_sess   = input.bool(true, "Intraday: previous session highs/lows (Asia/London/NY, 1H+ swing)", group=g1, tooltip="Intraday model only: add the previous Asia/London/NY session high and low as liquidity, but only when the session extreme is also a swing on the 1H chart or higher. Sessions use the New York clock.")
i_sessPiv = input.int(2, "Session: 1H swing size (candles each side)", minval=1, group=g1)

